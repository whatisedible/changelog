---
import Base from '../layouts/Base.astro';
import { APPS, FORUM_DISCUSS_URL, SITE_NAME, TOPICS } from '../lib/config';
import { entries, formatDate, type Entry } from '../lib/entries';

export function getStaticPaths() {
  return entries.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}
const { entry: e } = Astro.props as { entry: Entry };
---

<Base title={`${e.title} — ${SITE_NAME}`} description={e.summary} image={e.image}>
  <article class="entry">
    <p class="back"><a href="/">← All updates</a></p>
    <div class="meta">
      <time datetime={e.date}>{formatDate(e.date)}</time>
      <span class="chip topic">{TOPICS[e.topic]}</span>
      {e.apps.map((a) => (
        <span class="chip app">{APPS[a].label}</span>
      ))}
    </div>
    <h1>{e.title}</h1>
    {e.image && <img src={e.image} alt="" />}
    <div class="body" set:html={e.html} />
    {e.note && (
      <aside class="note">
        <strong>A note from the team</strong>
        <p>{e.note}</p>
      </aside>
    )}
    <p class="discuss"><a href={FORUM_DISCUSS_URL}>Discuss this on the forum →</a></p>
  </article>
</Base>
